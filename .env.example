# --- DashScope (Alibaba Model Studio / Bailian) ---
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen3.6-plus

# Endpoint region. Default = domestic (China).
# Use the intl endpoint below if your API key is from the Singapore/international console.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Local repo mount ---
# Absolute path on the HOST machine to mount into the container at /workspace/repo
LOCAL_REPO_PATH=/path/to/your/local/repo

# --- Git credentials for cloning private repos (optional) ---
# Leave blank for public repos.
GIT_USERNAME=
GIT_TOKEN=

# --- README output language (optional) ---
# id = Bahasa Indonesia, en = English
README_LANG=en
