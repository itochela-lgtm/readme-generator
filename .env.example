# --- LLM Provider ---
# dashscope (default) | openai | anthropic | gemini
LLM_PROVIDER=dashscope

# Optional: override the model name for any provider (else provider default is used)
# LLM_MODEL=qwen3.6-plus

# --- DashScope (Alibaba Model Studio / Bailian) — used when LLM_PROVIDER=dashscope ---
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen3.6-plus
# Endpoint region. Default = domestic (China).
# Use the intl endpoint below if your API key is from the Singapore/international console.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Anthropic (Claude) — used when LLM_PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini — used when LLM_PROVIDER=gemini ---
# GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (or any OpenAI-compatible provider) — used when LLM_PROVIDER=openai ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Leave OPENAI_BASE_URL unset to use official OpenAI. Or point it at any
# other OpenAI-compatible provider — most popular ones work out of the box:
#   OpenAI (official) : https://api.openai.com/v1
#   Groq               : https://api.groq.com/openai/v1
#   DeepSeek           : https://api.deepseek.com/v1
#   Mistral            : https://api.mistral.ai/v1
#   xAI (Grok)         : https://api.x.ai/v1
#   OpenRouter         : https://openrouter.ai/api/v1
#   Ollama (local)     : http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local repo mount ---
# Absolute path on the HOST machine to mount into the container at /workspace/repo
LOCAL_REPO_PATH=/path/to/your/local/repo

# --- Git credentials for cloning private repos (optional) ---
# Leave blank for public repos.
GIT_USERNAME=
GIT_TOKEN=

# --- README output language (optional) ---
# id = Bahasa Indonesia, en = English
README_LANG=en
